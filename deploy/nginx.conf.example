# nginx 反向代理示例
#
# 用法：
#   1. 把下面两处 __DOMAIN__ 换成你的域名（没有域名就换成服务器 IP）
#   2. 复制到 /etc/nginx/sites-available/text-message-bombing
#      ln -s /etc/nginx/sites-available/text-message-bombing /etc/nginx/sites-enabled/
#      nginx -t && systemctl reload nginx
#
# 开了防火墙的话记得放行：
#   ufw allow 80 && ufw allow 443
#   云服务器还要在控制台安全组里放开 80/443

server {
    listen 80;
    server_name __DOMAIN__;

    # 上传的请求体都很小，收紧一点
    client_max_body_size 1m;

    # 前端是静态文件，交给 nginx 直接发，省得每次都过 Python
    location /static/ {
        alias __APP_DIR__/static/;
        expires 7d;
        access_log off;
    }

    # 其余全部转给 gunicorn（它只监听 127.0.0.1:5000）
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 前端每 0.6 秒轮询一次，别让它超时
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;

        # 轮询接口不缓存
        proxy_buffering off;
    }

    # 健康检查，方便直接 curl http://域名/healthz
    location = /healthz {
        proxy_pass http://127.0.0.1:5000/healthz;
        access_log off;
    }
}

# HTTPS 用 certbot 一条命令就能加：
#   apt install -y certbot python3-certbot-nginx
#   certbot --nginx -d __DOMAIN__
# 加完 certbot 会自动改上面这段配置并帮你续期。
