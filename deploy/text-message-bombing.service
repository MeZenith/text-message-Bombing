[Unit]
Description=text-message-Bombing web service
Documentation=local:README-deploy.md
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# 单进程多线程：任务存在内存里，多进程会查不到任务（见 deploy/gunicorn.conf.py）
ExecStart=__APP_DIR__/.venv/bin/gunicorn -c __APP_DIR__/deploy/gunicorn.conf.py "app:create_app()"

Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# 一点基础加固，不影响程序跑
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
